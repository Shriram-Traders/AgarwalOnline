# Copy to .env and fill in. Never commit .env.
# Blank optional values mean "not configured" and the app falls back safely.

# ---- Core (required) ----
# Must be a replica set. Local: mongodb://127.0.0.1:27017/agarwal?replicaSet=rs0
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/agarwal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/agarwal?replicaSet=rs0
# Exact browser origin. Must be https:// in production.
APP_ORIGIN=http://127.0.0.1:3000
# 32+ random characters each. Generate with: openssl rand -hex 32
# AUTH_SECRET also hashes delivery handover codes, so keep it stable once live.
AUTH_SECRET=
BETTER_AUTH_SECRET=

# ---- Hostinger mailbox, for email confirmation links and quotations: set all three or none ----
# Blank in development: the email (with its link) is printed in the dev-server log instead.
# Blank in production: no emails are sent and the "Send confirmation link" button is hidden.
# SMTP_USER is the mailbox (orders@yourdomain.in), SMTP_PASS its password from hPanel → Emails.
# EMAIL_FROM uses the same mailbox, e.g. Agarwal General Stores <orders@yourdomain.in>
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Push notifications on phones and PCs: set both keys or neither; blank turns push off ----
# Make the pair once with `npm run push:keys` and keep it: a new pair means everyone turns notifications on again.
# VAPID_SUBJECT is how push services reach the shop: mailto:you@yourdomain.in or the https site address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Google sign-in: set both or neither; blank hides the button ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Login OTP ----
# Mock OTP is for development only; the app refuses to start with it in production.
MOCK_OTP=true
MOCK_OTP_CODE=246810
# Pre-launch test deployments only (Vercel always runs in production mode).
# Anyone who knows MOCK_OTP_CODE can then sign in as any phone number. Remove before real customers.
# ALLOW_MOCK_OTP_IN_PRODUCTION=true
# SMS gateway: set both or neither. Receives POST {"to","message"} with a Bearer token.
SMS_API_URL=
SMS_API_TOKEN=

# ---- Razorpay: all three or none; blank means cash on delivery only ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudinary evidence photos: all three or none; blank means .local/uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Search: true only after the Atlas Search index exists ----
ATLAS_SEARCH_ENABLED=false

# ---- Retention in days ----
EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730

# ---- Next.js: same value on every server and at build time ----
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---- Scheduled jobs on Vercel: sent by Vercel Cron as a Bearer token. 16+ characters. ----
# Generate with: openssl rand -hex 32. Without it, the cron routes refuse every call.
CRON_SECRET=

# ---- Shop assistant: the chat button in the corner. Blank keeps it hidden; "on" shows it ----
SHOP_ASSISTANT=

# ---- Demo seed: local only, refused in production. Staff are never seeded; run npm run owner:create ----
SEED_DEMO=true
